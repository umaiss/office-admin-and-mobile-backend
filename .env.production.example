# =============================================================================
#  OB Track — PRODUCTION environment
# =============================================================================
#  Copy this to `.env.production` ON THE SERVER and fill in real values.
#
#      cp .env.production.example .env.production
#      nano .env.production
#      chmod 600 .env.production      # readable only by you
#
#  ⚠ NEVER commit .env.production. It is already in .gitignore. A leaked JWT
#    secret lets anyone mint valid admin tokens for your API.
# =============================================================================

NODE_ENV=production
PORT=3000

# ---- Database ---------------------------------------------------------------
# These three are read by the postgres container to create the database, and
# are combined into DATABASE_URL below. The host `postgres` is the compose
# service name, resolved on the private container network.
POSTGRES_USER=obtrack
POSTGRES_DB=obtrack

# Generate with:  openssl rand -base64 32
# Must not contain characters that break a URL — the base64 above is safe apart
# from `+` and `/`, so regenerate if you see them, or URL-encode them.
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL="postgresql://obtrack:CHANGE_ME@postgres:5432/obtrack?schema=public"

# ---- Authentication ---------------------------------------------------------
# Generate with:  openssl rand -hex 32
# Minimum 32 characters, enforced at startup — the app refuses to boot otherwise.
# Changing this instantly invalidates every access token in circulation.
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32

# 7 days. A JWT cannot be revoked, so this is the maximum window a stolen token
# keeps working. Safe here only because JwtStrategy re-checks the account on
# every request. Shorten to 900 (15 min) for a stricter posture.
JWT_ACCESS_TTL_SECONDS=604800

# 30 days. Rotated on every use and revocable.
JWT_REFRESH_TTL_SECONDS=2592000

# 12 is a sensible 2026 default. Raising it makes both login and password
# hashing slower for everyone, so measure before increasing.
BCRYPT_SALT_ROUNDS=12

# ---- Reverse proxy ----------------------------------------------------------
# 1 = exactly one proxy (the nginx container) sits in front of the app.
# MUST be set, or rate limiting counts every user as the same client.
# Do NOT raise this above the real number of proxies: clients can forge
# X-Forwarded-For, and trusting extra hops lets anyone spoof their IP.
TRUST_PROXY_HOPS=1

# ---- Rate limiting ----------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=5

# ---- CORS -------------------------------------------------------------------
# Browser origins allowed to call this API. The React dashboard goes here.
# EMPTY MEANS NO BROWSER MAY CALL THE API — which is correct until the
# dashboard exists. The React Native app is not a browser and ignores CORS.
# Comma-separated, no trailing slash, e.g.:
#   CORS_ORIGINS=http://12.34.56.78,https://dashboard.example.com
CORS_ORIGINS=

# ---- API documentation ------------------------------------------------------
# Currently TRUE so you can test endpoints from /api/docs on the deployed box.
#
# ⚠ Set to false before real users exist. Public API docs hand an attacker a
#   complete map of your endpoints, parameters, and validation rules.
SWAGGER_ENABLED=true

# ---- File storage -----------------------------------------------------------
# Where receipt images are written inside the container.
#
# ⚠ This path MUST match the `uploads_data` volume mount in docker-compose.yml.
#   A container's filesystem is destroyed on every deploy, so a path outside
#   that volume loses every receipt uploaded since the last deploy — silently,
#   with no error, just downloads that start returning 404.
UPLOADS_DIR=/app/uploads

# Largest receipt upload accepted, in bytes (5242880 = 5 MB).
MAX_RECEIPT_BYTES=5242880

# ---- Reporting --------------------------------------------------------------
# Minutes ahead of UTC that the reporting calendar day runs on. The container
# runs UTC, so leaving this at 0 makes "completed today" roll over at 5am local
# time in Pakistan and split one working day across two report buckets.
# Set to 300 for Pakistan Standard Time (UTC+5).
REPORT_TZ_OFFSET_MINUTES=300

# ---- Observability ----------------------------------------------------------
# `info` in production. `debug` is noisy and can put request bodies in your logs.
LOG_LEVEL=info

# ---- Seeding ----------------------------------------------------------------
# Used only by `npm run prisma:seed`. REQUIRED in production — the seed script
# refuses to create a default administrator when NODE_ENV=production, because a
# well-known default password is a backdoor, not a convenience.
# Password must be at least 12 characters.
#
# QUOTE any value containing spaces. deploy.sh runs `source .env.production` to
# export these, and bash reads an unquoted space as the end of the assignment —
# `SEED_ADMIN_NAME=System Administrator` makes it try to run `Administrator` as
# a command, and the deploy fails with "command not found".
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS
SEED_ADMIN_NAME="System Administrator"
