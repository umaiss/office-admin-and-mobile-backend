##
## OB Track Backend — environment template
##
## Copy this file to `.env` and fill in real values:
##     cp .env.example .env
##
## `.env` is git-ignored and must NEVER be committed. This file is committed,
## so it must never contain a real secret. Its job is to tell a new developer
## exactly which variables exist — the single most common cause of "it doesn't
## work on my machine" is an undocumented environment variable.
##
## Every variable here is declared and validated in src/config/env.schema.ts.
## The application refuses to start if any required value is missing or invalid.
##

# ---- Runtime ----------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development
PORT=3000

# ---- Database ---------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/OBTrack?schema=public"

# ---- Authentication ---------------------------------------------------------
# Used to sign JWTs. Minimum 32 characters — anything shorter can be brute
# forced offline. Generate a strong one with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a DIFFERENT secret in every environment. If staging and production share
# a secret, a staging token unlocks production.
JWT_SECRET="replace-me-with-at-least-32-random-characters"

# Access token lifetime in seconds (900 = 15 minutes).
# Short on purpose: a JWT cannot be revoked, so a stolen one stays valid until
# it expires. Short lifetime = short window of damage.
# A JWT cannot be revoked, so this value is the maximum window during which a
# stolen token keeps working. 900 (15 minutes) is the conventional choice.
# This project runs 604800 (7 days) by explicit decision; that is only safe
# because JwtStrategy re-checks the account against the database on every
# request, making deactivation take effect immediately.
JWT_ACCESS_TTL_SECONDS=604800

# Refresh token lifetime in seconds (2592000 = 30 days).
# Long-lived, but stored hashed, rotated on every use, and revocable.
JWT_REFRESH_TTL_SECONDS=2592000

# bcrypt cost factor. Each +1 doubles hashing time (10–14 allowed).
# 12 is a good balance of security and login latency.
BCRYPT_SALT_ROUNDS=12

# ---- Rate limiting -----------------------------------------------------------
# General API ceiling.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Auth endpoints, deliberately much stricter. This is the only defence against
# password guessing and credential stuffing — strong password rules do not help
# when the attacker already knows the password from another site's breach.
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=5

# ---- HTTP -------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API.
# The React admin dashboard goes here. The React Native app does NOT need to be
# listed — CORS is a browser mechanism and native apps ignore it.
# Leave empty to block all browser origins.
CORS_ORIGINS="http://localhost:5173,http://localhost:3001"

# ---- File storage -----------------------------------------------------------
# Where receipt images are written by the local-disk storage driver.
#
# MUST survive a redeploy. Inside a container the default lands on the
# container's own filesystem, which is destroyed and recreated on every deploy —
# mount a volume here or this morning's receipts are gone this afternoon.
# See the `uploads` volume in docker-compose.yml.
UPLOADS_DIR="./uploads"

# Largest receipt upload accepted, in bytes (5242880 = 5 MB).
# Enforced by multer while the request is read, so an oversized upload is
# aborted mid-transfer rather than buffered in full and then rejected.
MAX_RECEIPT_BYTES=5242880

# ---- Reporting --------------------------------------------------------------
# Minutes ahead of UTC that the reporting calendar day runs on.
#
# "Completed today" has to mean the OFFICE's today, not the server's. A
# container running UTC rolls the day over at 5am local time in Pakistan, which
# splits one working day across two report buckets.
#   0   = report in UTC
#   300 = Pakistan Standard Time (UTC+5)
REPORT_TZ_OFFSET_MINUTES=0

# ---- Seeding ----------------------------------------------------------------
# Used ONLY by `npm run prisma:seed`, never by the running application, so they
# are validated inside prisma/seed.ts rather than in src/config/env.schema.ts.
#
# In development these may be omitted and the seed falls back to a documented
# default. In production they are REQUIRED and the password must be at least 12
# characters — a seed script with a well-known default password is a backdoor,
# so it refuses to run rather than create one.
SEED_ADMIN_EMAIL="admin@obtrack.local"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="System Administrator"

# ---- Observability ----------------------------------------------------------
# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Serve interactive API docs at /api/docs.
# Keep this false in production: it publishes a complete map of the API.
SWAGGER_ENABLED=true
